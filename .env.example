# Environment (never commit real values)

# Postgres (Neon)
DATABASE_URL=

# Cron / report auth (api/link-check, api/bot-report, api/cron/retention, api/cron/email-digest)
CRON_SECRET=

# Optional accounts (JWT cookies). AUTH_SECRET must be a long random string.
AUTH_SECRET=
# Comma-separated emails that become is_admin on register/login
ADMIN_EMAILS=
# Password max age in months (default 6). Google-only accounts are exempt.
# PASSWORD_MAX_AGE_MONTHS=6
# Google OAuth (optional). Redirect URI: {AUTH_APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public origin used in confirm/unsubscribe links (defaults to https://nefesh-il.org in production)
# AUTH_APP_URL=https://nefesh-il.org
# Sender for confirm + site-update mail (falls back to LINK_CHECK_FROM_EMAIL).
# Confirm mail is queued but not sent until RESEND_API_KEY and a From address are set.
# UPDATES_FROM_EMAIL=updates@nefesh-il.org

# Request logging kill switch and human sample rate (middleware.ts)
# REQUEST_LOG_DISABLED=1
# REQUEST_LOG_HUMAN_SAMPLE=0.1

# Analytics CORS (optional)
# ANALYTICS_ALLOWED_ORIGINS=https://nefesh-il.org

# Link checker
# RESEND_API_KEY=
# LINK_CHECK_FROM_EMAIL=
# LINK_CHECK_NOTIFY_EMAIL=

# Care document storage. Objects are AES-256-GCM ciphertext (FILE_ENCRYPTION_KEY still required).
# IAM: s3:PutObject, s3:GetObject, s3:DeleteObject on arn:aws:s3:::BUCKET/care/*
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# GEO experiment runner (experiments/run.js)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-3.6-flash
